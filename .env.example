# Configure only after approval, using the exact approved Neon branch.
# All values below are server-only. Do not add NEXT_PUBLIC_ aliases.
# No real credentials are included. Missing configuration fails closed.
DATABASE_URL=
# Optional restricted-role override for integration-managed preview environments.
# Omit this variable locally unless overriding DATABASE_URL.
# APAT_DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
APP_ORIGIN=http://127.0.0.1:3026
# Direct migration connection; never read by application requests.
DATABASE_URL_UNPOOLED=

# Mamitsu imports: explicit activation and approved lifetime credit ceilings.
# Leave disabled until migration 0002, runtime grants and server setup are approved.
MAMITSU_IMPORTS_ENABLED=false
MAMITSU_API_KEY=
MAMITSU_TOTAL_CREDITS=
MAMITSU_OWNER_CREDITS=
