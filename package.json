{
  "name": "apat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3026",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3026",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm test:lint-rules",
    "test:lint-rules": "node scripts/test-lint-rules.mjs",
    "test:browser": "playwright test",
    "experiment:instagram": "tsx scripts/instagram-experiment.ts",
    "experiment:instagram:browser": "tsx scripts/instagram-browser-experiment.ts",
    "experiment:instagram:media": "tsx scripts/inspect-observed-media.ts",
    "db:generate": "drizzle-kit generate",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tailwindcss/postcss": "4.3.3",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@oxlint/plugins": "1.89.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x || 26.x"
  },
  "packageManager": "pnpm@12.4.2"
}
